# Google Gemini API Key
# Kostenlos holen unter: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Admin-Token für geschützte Endpunkte (selbst festlegen, z.B. ein langes Passwort)
ADMIN_TOKEN=your_secret_admin_token_here

# CORS – Deine KWS-Website-Domain (mit https://)
ALLOWED_ORIGIN=https://www.kletterwelt-sauerland.de

# E-Mail-Einstellungen (für Auto-Reply-Funktion)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine@email.de
SMTP_PASS=dein_app_passwort
SMTP_FROM=KWS Bot <deine@email.de>

# Port (Render.com setzt das automatisch)
PORT=3000
